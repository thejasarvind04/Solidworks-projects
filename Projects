<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My SolidWorks Projects</title>
  <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.3.0/model-viewer.min.js"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #0d0d0d;
      color: #e0e0e0;
      min-height: 100vh;
      padding: 3rem 2rem;
    }

    header {
      text-align: center;
      margin-bottom: 4rem;
    }

    h1 {
      font-size: 2rem;
      font-weight: 300;
      letter-spacing: 0.1em;
      color: #ffffff;
      margin-bottom: 0.5rem;
    }

    .subtitle {
      color: #666;
      font-size: 0.875rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 2rem;
      max-width: 1400px;
      margin: 0 auto;
    }

    .card {
      background: #161616;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid #222;
      transition: border-color 0.2s;
    }

    .card:hover {
      border-color: #333;
    }

    .viewer {
      width: 100%;
      height: 280px;
      background: #0a0a0a;
      position: relative;
      overflow: hidden;
    }

    .thumbnail {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      cursor: pointer;
      transition: opacity 0.3s;
    }

    .thumbnail:hover {
      opacity: 0.85;
    }

    .placeholder-thumb {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 1rem;
      cursor: pointer;
      transition: opacity 0.3s;
    }

    .placeholder-thumb:hover {
      opacity: 0.8;
    }

    .placeholder-thumb svg {
      opacity: 0.3;
    }

    .placeholder-thumb span {
      font-size: 0.75rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      opacity: 0.25;
    }

    model-viewer {
      width: 100%;
      height: 100%;
      --poster-color: transparent;
    }

    .viewer-header {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      padding: 0.75rem 1rem;
      background: linear-gradient(to bottom, rgba(0,0,0,0.5), transparent);
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 5;
      pointer-events: none;
    }

    .view-toggle {
      background: rgba(255,255,255,0.1);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255,255,255,0.15);
      color: #fff;
      padding: 0.35rem 0.75rem;
      border-radius: 6px;
      font-size: 0.7rem;
      cursor: pointer;
      pointer-events: all;
      transition: background 0.2s;
    }

    .view-toggle:hover {
      background: rgba(255,255,255,0.2);
    }

    .info {
      padding: 1.25rem;
    }

    .info h2 {
      font-size: 1rem;
      font-weight: 500;
      margin-bottom: 0.25rem;
    }

    .info p {
      font-size: 0.8rem;
      color: #666;
      margin-bottom: 1rem;
    }

    .parts-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .part-tag {
      padding: 0.25rem 0.6rem;
      background: #1a1a1a;
      border-radius: 4px;
      font-size: 0.7rem;
      color: #555;
    }

    .file-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 1rem;
      padding: 0.5rem 0.75rem;
      background: #1a1a1a;
      border-radius: 6px;
      color: #888;
      text-decoration: none;
      font-size: 0.75rem;
      transition: background 0.2s, color 0.2s;
    }

    .file-link:hover {
      background: #252525;
      color: #e0e0e0;
    }

    .file-link svg {
      width: 14px;
      height: 14px;
    }

    [hidden] {
      display: none !important;
    }
  </style>
</head>
<body>

  <header>
    <h1>SolidWorks Projects</h1>
    <p class="subtitle">Interactive 3D Models</p>
  </header>

  <div class="grid">

    <!-- FVP Drone Frame -->
    <div class="card">
      <div class="viewer" id="viewer-drone">
        <div class="viewer-header">
          <span style="font-size:0.65rem;color:rgba(255,255,255,0.5);pointer-events:none;">Click to interact</span>
          <button class="view-toggle" onclick="toggleView('drone')">View 3D</button>
        </div>
        <img src="models/FVP Drone 5 Inch_Frame.JPG" alt="FVP Drone Frame" class="thumbnail" onclick="toggleView('drone')">
        <model-viewer src="models/FVP Drone Frame - Top_plate-1.STL" auto-rotate camera-controls shadow-intensity="1" environment-image="neutral" hidden>
        </model-viewer>
      </div>
      <div class="info">
        <h2>FVP Drone Frame</h2>
        <p>5-inch FPV racing drone frame with modular plate design</p>
        <div class="parts-list">
          <span class="part-tag">Top Plate</span>
          <span class="part-tag">Mid Plate</span>
          <span class="part-tag">Down Plate</span>
          <span class="part-tag">Side Plates</span>
          <span class="part-tag">Arms</span>
        </div>
        <a href="models/FVP%20Drone%20Frame%20-%20Top_plate-1.STL" download class="file-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Top Plate STL
        </a>
        <a href="models/FVP%20Drone%20Frame%20-%20Down_plate-1.STL" download class="file-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Down Plate STL
        </a>
      </div>
    </div>

    <!-- Modular Wing -->
    <div class="card">
      <div class="viewer" id="viewer-wing">
        <div class="viewer-header">
          <span style="font-size:0.65rem;color:rgba(255,255,255,0.5);pointer-events:none;">Click to interact</span>
          <button class="view-toggle" onclick="toggleView('wing')">View 3D</button>
        </div>
        <svg class="placeholder-thumb" onclick="toggleView('wing')" viewBox="0 0 340 280" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="wing-grad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" style="stop-color:#1a1a1a"/>
              <stop offset="100%" style="stop-color:#0d0d0d"/>
            </linearGradient>
          </defs>
          <rect width="340" height="280" fill="url(#wing-grad)"/>
          <path d="M50 200 L170 100 L290 200 L260 200 L170 130 L80 200 Z" fill="none" stroke="#e0e0e0" stroke-width="1.5" opacity="0.4"/>
          <path d="M120 175 L170 140 L220 175" fill="none" stroke="#e0e0e0" stroke-width="1" opacity="0.2"/>
          <text x="170" y="245" text-anchor="middle" fill="#e0e0e0" font-size="10" letter-spacing="3" opacity="0.35" font-weight="300">MODULAR WING</text>
        </svg>
        <model-viewer src="models/Modular%20wing.STL" auto-rotate camera-controls shadow-intensity="1" environment-image="neutral" hidden>
        </model-viewer>
      </div>
      <div class="info">
        <h2>Modular Wing</h2>
        <p>Detachable wing module with quick-release mechanism</p>
        <div class="parts-list">
          <span class="part-tag">Wing Section</span>
        </div>
        <a href="models/Modular%20wing.STL" download class="file-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Download STL
        </a>
      </div>
    </div>

    <!-- VTOL -->
    <div class="card">
      <div class="viewer" id="viewer-vtol">
        <div class="viewer-header">
          <span style="font-size:0.65rem;color:rgba(255,255,255,0.5);pointer-events:none;">Click to interact</span>
          <button class="view-toggle" onclick="toggleView('vtol')">View 3D</button>
        </div>
        <svg class="placeholder-thumb" onclick="toggleView('vtol')" viewBox="0 0 340 280" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="vtol-grad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" style="stop-color:#1a1a1a"/>
              <stop offset="100%" style="stop-color:#0d0d0d"/>
            </linearGradient>
          </defs>
          <rect width="340" height="280" fill="url(#vtol-grad)"/>
          <path d="M170 60 L200 120 L260 130 L220 170 L230 220 L170 190 L110 220 L120 170 L80 130 L140 120 Z" fill="none" stroke="#e0e0e0" stroke-width="1.5" opacity="0.4"/>
          <path d="M170 100 L170 160" stroke="#e0e0e0" stroke-width="1" opacity="0.2"/>
          <circle cx="170" cy="200" r="8" fill="none" stroke="#e0e0e0" stroke-width="1" opacity="0.2"/>
          <text x="170" y="255" text-anchor="middle" fill="#e0e0e0" font-size="10" letter-spacing="3" opacity="0.35" font-weight="300">VTOL</text>
        </svg>
        <model-viewer src="models/VTOL.STL" auto-rotate camera-controls shadow-intensity="1" environment-image="neutral" hidden>
        </model-viewer>
      </div>
      <div class="info">
        <h2>VTOL</h2>
        <p>Vertical takeoff and landing aircraft design</p>
        <div class="parts-list">
          <span class="part-tag">Full Assembly</span>
        </div>
        <a href="models/VTOL.STL" download class="file-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Download STL
        </a>
      </div>
    </div>

  </div>

  <script>
    function toggleView(id) {
      const viewer = document.getElementById('viewer-' + id);
      const img = viewer.querySelector('img, .placeholder-thumb');
      const model = viewer.querySelector('model-viewer');
      const btn = viewer.querySelector('.view-toggle');

      const isShowingPhoto = !img.hidden;

      if (isShowingPhoto) {
        img.hidden = true;
        model.hidden = false;
        btn.textContent = 'View Photo';
      } else {
        img.hidden = false;
        model.hidden = true;
        btn.textContent = 'View 3D';
      }
    }
  </script>

</body>
</html>
